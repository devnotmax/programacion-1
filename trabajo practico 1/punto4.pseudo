algoritmo reservaCabañas
Entradas: categoria: Entero (0 = MF, 1 = estandar, 2 = superior, 3 = premium, 4 = lujo), cantidadNoches: Entero, esExtranjero: booleano
Salidas: totalRecaudado, montoDescuento: Real, cant_reservas_estandar, cant_reservas_superior, cant_reservas_premium, cant_reservas_lujo, cantReservasMas14Extranjeros: Entero
variables auxiliares: montoSinDescuento: Real, montoFinal: Real, descuento: Real

procedimiento mostrarDetalleReserva(categoria, cantidadNoches, montoFinal) : 

    Escribir("Tipo de cabaña reservada: ", categoria)
    Escribir("Cantidad de noches: ", cantidadNoches)
    Escribir("Monto final de reserva: $", montoFinal)
fin_procedimiento

A0 Inicializar
A1 procesarReservas
A2 finalizarJornada
A3 Parar

A0 Inicializar
    totalRecaudado <- 0 
    montoDescuento <- 0
    cant_reservas_estandar <- 0
    cant_reservas_superior <- 0
    cant_reservas_premium <- 0
    cant_reservas_lujo <- 0
    cantReservasMas14Extranjeros <- 0
    montoSinDescuento <- 0
    montoFinal <- 0
    descuento <- 0

A1 procesarReservas
    Leer(categoria)

    Mientras (categoria <> 0)
        Leer(cantidadNoches)
        Leer(esExtranjero)
        
        segun (categoria)
            1: //categoria estandar
                montoSinDescuento <- cantidadNoches * 410000
                cant_reservas_estandar <- cant_reservas_estandar + 1
            2: //categoria superior
                montoSinDescuento <- cantidadNoches * 460000
                cant_reservas_superior <- cant_reservas_superior + 1
            3: //categoria premium
                montoSinDescuento <- cantidadNoches * 515000
                cant_reservas_premium <- cant_reservas_premium + 1
            4: //categoria lujo
                montoSinDescuento <- cantidadNoches * 580000
                cant_reservas_lujo <- cant_reservas_lujo + 1
        fin_segun

        //Aplico el descuento segun la cantidad de noches que haya contratado
        segun (cantidadNoches)
            //Entre 5 y 7 noches: 10% de descuento
            cantidadNoches >= 5 & cantidadNoches <= 7: 
                montoFinal <- montoSinDescuento * 0.9
                descuento <- montoSinDescuento - montoFinal
            //Entre 8 y 14 noches: 20% de descuento
            cantidadNoches >= 8 & cantidadNoches <= 14: 
                montoFinal <- montoSinDescuento * 0.8
                descuento <- montoSinDescuento - montoFinal
            //Más de 14 noches: 30%
            cantidadNoches > 14: 
                montoFinal <- montoSinDescuento * 0.7
                descuento <- montoSinDescuento - montoFinal
                si (esExtranjero = verdadero) entonces
                    cantReservasMas14Extranjeros <- cantReservasMas14Extranjeros + 1
                Fin_si
            Sino: //Menos de 5 noches: no hay descuento
                montoFinal <- montoSinDescuento
                descuento <- 0
        fin_segun

        // Acá uso el procedimiento solo para mostrar como pide el foro
        mostrarDetalleReserva(categoria, cantidadNoches, montoFinal)
        
        // acumulo para el final
        totalRecaudado <- totalRecaudado + montoFinal
        montoDescuento <- montoDescuento + descuento

        Leer(categoria)
    Fin_mientras

A2 finalizarJornada
    Escribir("Monto total recaudado: $", totalRecaudado)
    Escribir("Monto total de descuentos: $", montoDescuento)
    Escribir("Cantidad de reservas estandar: ", cant_reservas_estandar)
    Escribir("Cantidad de reservas superior: ", cant_reservas_superior)
    Escribir("Cantidad de reservas premium: ", cant_reservas_premium)
    Escribir("Cantidad de reservas lujo: ", cant_reservas_lujo)
    Escribir("Cantidad de reservas con más de 14 noches: ", cantReservasMas14Extranjeros)