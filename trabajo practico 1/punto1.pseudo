Algotimo empresa_logistica
Entradas: pesopaquete: Real (MF = 0), capacidadMaxima: Real
Salidas: pesototalCargado: Real, paquetesCargados: Entero
Variables auxiliares: cargarestante: Real, diferencia: Real

A0 Inicializar
A1 procesarPaquetes
A2 Escribir("Peso total cargado: ", pesototalCargado, " kg")
A3 Escribir("Paquetes cargados: ", paquetesCargados)
A4 Parar

A0 Inicializar
    pesototalCargado <- 0
    paquetesCargados <- 0
    diferencia <- 0

A1 procesarPaquetes
    Leer(capacidadMaxima)
    cargarestante <- capacidadMaxima

    Leer(pesopaquete)
    Mientras (pesopaquete <> 0)
        si (pesopaquete < 0) entonces
            escribir("Error: El peso del paquete no puede ser negativo.")
        sino
            si (pesopaquete <= cargarestante) entonces
                pesototalCargado <- pesototalCargado + pesopaquete
                paquetesCargados <- paquetesCargados + 1
                cargarestante <- cargarestante - pesopaquete
            sino
                diferencia <- pesopaquete - cargarestante
                escribir("No se puede cargar el paquete. Diferencia: ", diferencia) 
            Fin_si
        Fin_si
        Leer(pesopaquete)
    Fin_Mientras

